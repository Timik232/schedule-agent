# LLM Configuration
LLM_PROVIDER=copilot # or lm_studio
LLM_API_BASE_URL=https://api.githubcopilot.com
LLM_API_KEY=ghp-your-token-here
LLM_MODEL=gpt-4o-mini-copilot
LLM_TEMPERATURE=0.0

# Database Configuration
DATABASE_URL=postgresql+asyncpg://schedule_user:your_password@localhost:5432/schedule_db
SQLITE_SEED_PATH="./min (1).db"

# Security Limits
MAX_SQL_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=schedule-ai-agent
