# LLM Configuration
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Database Configuration
DATABASE_URL=postgresql+asyncpg://schedule_user:your_password@localhost:5432/schedule_db

# Security Limits
MAX_SQL_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=schedule-ai-agent
